{
  "name": "@divparser/client",
  "version": "2.0.0",
  "description": "TypeScript client SDK for the DivParser API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/save.d.ts",
      "import": "./dist/save.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "keywords": [
    "divparser",
    "web scraping",
    "html parsing",
    "sdk",
    "api"
  ],
  "author": "solomon344",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cross-fetch": "^3.1.8",
    "papaparse": "^5.7.0",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.5.4"
  }
}
